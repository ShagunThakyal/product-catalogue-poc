# Copy to .env for local (non-docker) runs. docker compose sets these for you.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Product data source (swap for a real PIM/API later)
PRODUCT_API_BASE_URL=https://fakestoreapi.com
CATALOGUE_CACHE_TTL_SECONDS=300

# The 5 "top rated" products chosen by the business, in display order.
# Leave empty to fall back to the 5 highest-rated products.
FEATURED_PRODUCT_IDS=1,5,9,13,17
CATEGORY_TOP_RATED_COUNT=3

# Enquiry email. Defaults target Mailpit (local SMTP catcher, UI on http://localhost:8025)
SALES_INBOX=sales@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catalogue <no-reply@example.com>
